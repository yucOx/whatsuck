{
  "name": "whatsuck",
  "version": "1.0.0",
  "description": "WhatsApp Web as a native Ubuntu desktop app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux deb"
  },
  "author": {
    "name": "yucOx",
    "email": "yucOx@users.noreply.github.com"
  },
  "homepage": "https://web.whatsapp.com",
  "license": "MIT",
  "desktopName": "whatsuck",
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.whatsuck.app",
    "productName": "Whatsuck",
    "afterPack": "build/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "yucOx",
      "repo": "whatsuck"
    },
    "linux": {
      "target": "deb",
      "category": "Network",
      "icon": "assets/icon",
      "maintainer": "yucOx",
      "synopsis": "WhatsApp Web as a native desktop app",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
